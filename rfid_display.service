Unit]
Description=RFID USB rentgen Screen Service
After=graphical.target

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/rentgen/.Xauthority
WorkingDirectory=/home/rentgen
ExecStart=/usr/bin/python3 /home/rentgen/rentgen.py
Restart=always
RestartSec=5
User=rentgen

[Install]
WantedBy=graphical.target
